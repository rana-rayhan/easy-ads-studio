# Copy this file to backend/.env and change the values if needed:
#   cp backend/.env.sample backend/.env
# Never commit backend/.env (it is in .gitignore).

# ---------- App ----------
# "dev" turns on request logs and Swagger at http://localhost:4040/api-docs
STAGE=dev
# The API runs on http://localhost:4040
SERVER_PORT=4040
# Where the React app runs
CLIENT_HOST_REACT=http://localhost:5173
# "required" = create the database tables automatically when the backend starts
DB_MIGRATION=required

# ---------- Login (JWT) ----------
# Any long random text. Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-1234567890
JWT_REFRESH_SECRET=change-me-refresh-secret-1234567890

# ---------- PostgreSQL (users) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=admanager_db

# ---------- Redis (login sessions and job status) ----------
REDIS_URL=redis://localhost:6379

# ---------- RabbitMQ (job queue for the worker) ----------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---------- Google Ads (optional, only needed for the "Google Ads" section) ----------
# "mock" = the worker fakes the Google step
GOOGLE_ADS_MODE=mock
GOOGLE_ADS_API_VERSION=v26
# Test CLIENT account id (where campaigns are created), without dashes
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Test MANAGER account id (the account you log in through), without dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210
# Service account key file, placed inside backend/ (never commit it)
GOOGLE_ADS_KEY_FILE=./google-ads-key.json

# ---------- AI (Ollama: free AI that runs on your computer, https://ollama.com) ----------
# Where Ollama runs (default after install)
OLLAMA_URL=http://localhost:11434
# Small model that understands text and images (download once: ollama pull gemma3:4b)
OLLAMA_MODEL=gemma3:4b
